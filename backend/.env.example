# WinPlay / BetRally Backend Environment Configuration

# Django Settings
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-only-winplay-key-change-before-deployment

# Supabase PostgreSQL Database Configuration
# Replace [YOUR-PASSWORD] with your actual Supabase database password:
DATABASE_URL=postgresql://postgres.zcslpyqbusbdsggrdtma:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Admin WhatsApp Number (for Player Manual Payment Verification)
# Example: +919876543210 (include country code without spaces or dashes)
ADMIN_WHATSAPP_NUMBER=+919876543210

# Email Settings (for sending real password reset OTP emails to user inboxes)
WINPLAY_EMAIL=
WINPLAY_EMAIL_PASSWORD=
WINPLAY_FROM_EMAIL=
WINPLAY_EMAIL_HOST=smtp.gmail.com
WINPLAY_EMAIL_PORT=587
WINPLAY_EMAIL_USE_TLS=True
WINPLAY_EMAIL_USE_SSL=False

# NOTE: If DATABASE_URL contains [YOUR-PASSWORD], Django automatically falls back
# to local SQLite so that offline development never breaks!
